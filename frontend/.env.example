# ============================================================
# AgroCare AI — Frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# All variables MUST be prefixed VITE_ to be exposed to the browser.
# ============================================================

# AWS Region (must match the deployed SAM stack)
VITE_AWS_REGION=ap-south-1

# Amazon Cognito — get from SAM stack outputs after deployment
# aws cloudformation describe-stacks --stack-name agrocare-ai-dev --query "Stacks[0].Outputs"
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway base URL — from SAM stack output "ApiUrl"
# e.g. https://abc123xyz.execute-api.ap-south-1.amazonaws.com/dev
VITE_API_BASE_URL=https://REPLACE_WITH_API_GATEWAY_URL/dev
