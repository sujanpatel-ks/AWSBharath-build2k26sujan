# ============================================================
# AgroCare AI — Backend / Lambda environment variables
# These are set via SAM template (template.yaml) Globals + per-function env.
# This file documents all variables for local development and reference.
# NEVER commit real values. Use SSM Parameter Store for secrets.
# ============================================================

# AWS Region
AWS_REGION_NAME=ap-south-1

# DynamoDB table name (from SAM output DynamoTableName)
DYNAMODB_TABLE=AgroCare-Main-dev

# S3 bucket for crop images (from SAM output CropImagesBucketName)
S3_IMAGES_BUCKET=agrocare-crop-images-dev-123456789012

# S3 bucket for agricultural documents (from SAM output AgriculturalDocsBucketName)
S3_DOCUMENTS_BUCKET=agrocare-agri-docs-dev-123456789012

# Cognito (from SAM outputs)
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bedrock model IDs (verified ap-south-1, Sept 2026) ─────────────
# DO NOT change these unless AWS officially deprecates these IDs.
HAIKU_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
SONNET_MODEL_ID=anthropic.claude-sonnet-4-6
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Bedrock Knowledge Base ──────────────────────────────────────────
# Set after creating the Knowledge Base manually or via CDK/console.
# Store in SSM: aws ssm put-parameter --name /agrocare/knowledge-base-id --value <id> --type String
KNOWLEDGE_BASE_ID=REPLACE_WITH_KB_ID

# ── Bedrock Guardrail (optional — leave blank to skip) ─────────────
GUARDRAIL_ID=
GUARDRAIL_VERSION=1

# ── Weather API ─────────────────────────────────────────────────────
# OpenWeatherMap free tier API key.
# Store in SSM: aws ssm put-parameter --name /agrocare/weather-api-key --value <key> --type SecureString
# Lambda reads this via SSM — do NOT put the key here in production.
WEATHER_API_KEY_PARAM=/agrocare/weather-api-key

# For local testing only — not used in Lambda (Lambda reads from SSM)
WEATHER_API_KEY_LOCAL=REPLACE_WITH_OPENWEATHERMAP_KEY

# ── SNS (from SAM output SNSAlertTopicArn) ──────────────────────────
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:agrocare-alerts-dev

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
POWERTOOLS_SERVICE_NAME=agrocare-ai
